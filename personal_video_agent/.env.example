# OpenAI-compatible chat endpoint. Copy this file to .env and fill in your own credentials.
# PVA_LLM_BASE_URL=https://api.deepseek.com
# PVA_LLM_API_KEY=replace-me
# PVA_LLM_MODEL=deepseek-flash
# When the endpoint host is api.deepseek.com, every AI call uses deepseek-flash:
# photo identification, match checks, translation, frame reading, summary,
# and classification. Other compatible providers use the configured model.

# Video-frame reading defaults to local PaddleOCR-VL 1.6. Photo card identification
# and summaries still use the language-model API above. Paid fallback is opt-in.
PVA_FRAME_READER=paddleocr
PVA_VISUAL_API_FALLBACK=false
PVA_PADDLE_DEVICE=cpu
# Optional: absolute path to a separately installed local vision Python runtime.
# PVA_PADDLE_PYTHON=D:/path/to/.venv-paddleocr/Scripts/python.exe
